# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/delivery_option?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Encryption (AES-256-GCM key for partner integration credentials at rest — set a real
# random 32+ byte value in every real environment; falls back to JWT_SECRET if unset)
ENCRYPTION_KEY=your-32-byte-random-encryption-key-change-in-production

# Email (SMTP - mail.neg.co.tz)
SMTP_HOST=mail.neg.co.tz
SMTP_PORT=465
SMTP_USER=contact@neg.co.tz
SMTP_PASS=your-smtp-password
SMTP_FROM=Xerin Express <contact@neg.co.tz>

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# SMS (mShastra Gateway)
SMS_PROVIDER=mshastra
SMS_API_URL=http://mshastra.com/sendsms_api_json.aspx
SMS_USERNAME=XERINDELIV
SMS_PASSWORD=your-sms-password
SMS_SENDER_ID=XERINDELIV

# WhatsApp Engine (Baileys) session data is encrypted with the same ENCRYPTION_KEY above
# (see src/modules/whatsapp/baileys-provider.js) — no separate key needed.
