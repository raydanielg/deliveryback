// ============================================================
// ASSIGNMENTS & MANIFESTS
// ============================================================

model Assignment {
  id           String       @id @default(cuid())
  shipmentId   String
  driverId     String
  vehicleId    String?
  assignedById String
  status       AssignmentStatus @default(ASSIGNED)
  assignedAt   DateTime     @default(now())
  acceptedAt   DateTime?
  completedAt  DateTime?
  notes        String?
  capacityOverridden Boolean @default(false)
  overrideReason String?
  overrideById String?

  shipment     Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  driver       Driver       @relation(fields: [driverId], references: [id])
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])
  assignedBy   User         @relation("assignmentsAssignedBy", fields: [assignedById], references: [id])
  trip         Trip?

  @@map("assignments")
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Manifest {
  id              String       @id @default(cuid())
  manifestNumber  String       @unique
  routeId         String?
  driverId        String?
  vehicleId       String?
  createdById     String
  departureAt     DateTime?
  arrivalAt       DateTime?
  totalShipments  Int          @default(0)
  totalWeightKg   Decimal      @default(0) @db.Decimal(8, 2)
  status          ManifestStatus @default(PENDING)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // SGR Parcel Manifest fields
  batchNo         String?
  originStation   String?
  destinationStation String?
  serviceType     String?
  reservedBlockSpaceKg Decimal? @db.Decimal(10, 2)
  qrCode          String?
  dispatchDate    DateTime?

  route           Route?       @relation(fields: [routeId], references: [id])
  driver          Driver?      @relation(fields: [driverId], references: [id])
  vehicle         Vehicle?     @relation(fields: [vehicleId], references: [id])
  createdBy       User         @relation("manifestsCreatedBy", fields: [createdById], references: [id])
  shipments       Shipment[]
  handovers       ManifestHandover[]
  station         Station?     @relation("stationManifests", fields: [stationId], references: [id])
  trainAllocations TrainAllocation[]
  sgrLegs         SGRLeg[]     @relation("sgrLegManifest")

  // Station reference for SGR manifests
  stationId       String?

  @@map("manifests")
}

model ManifestHandover {
  id          String   @id @default(cuid())
