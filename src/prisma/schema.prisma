  name        String?
  signature   String?
  date        DateTime?
  time        String?
  completedById String?
  completedAt  DateTime?  @default(now())

  manifest    Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  completedBy User?    @relation("handoverCompletedBy", fields: [completedById], references: [id])

  @@map("manifest_handovers")
}

enum HandoverStep {
  PREPARED
  VERIFIED_STATION
  HANDED_OVER_RAIL
  RECEIVED_DESTINATION
  RECONCILED
}

enum ManifestStatus {
  PENDING
  LOADING
  DEPARTED
  IN_TRANSIT
  ARRIVED
  COMPLETED
  CANCELLED
}

// ============================================================
