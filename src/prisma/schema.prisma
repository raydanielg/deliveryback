enum PackageType {
  DOCUMENT
  PARCEL
  BOX
  BAG
  PALLET
  CRATE
  CARGO
  ENVELOPE
  OTHER
}

enum PackageStatus {
  CREATED
  SCANNED_AT_PICKUP
  SCANNED_AT_WAREHOUSE
  LOADED
  DEPARTED
  ARRIVED
  OUT_FOR_DELIVERY
  DELIVERED
  DAMAGED
  LOST
}

// ============================================================
// TRACKING
// ============================================================

model TrackingEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  event       String
  status      ShipmentStatus
  description String
  location    String?
  latitude    Float?
  longitude   Float?
  createdBy   String?
