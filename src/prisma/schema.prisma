generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & USERS
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  phone         String?   @unique
  role          UserRole  @default(CUSTOMER)
  avatar        String?
  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)
  resetOtp      String?
  resetOtpExp   DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer      Customer?
  driver        Driver?
  organizationUsers OrganizationUser[]
  notifications Notification[]
  auditLogs     AuditLog[]
  shipments     Shipment[]      @relation("shipmentsCreatedBy")
  orders        Order[]         @relation("ordersCreatedBy")
  quotes        Quote[]         @relation("quotesCreatedBy")
  quoteRequests QuoteRequest[]
  payments      Payment[]
  assignments   Assignment[]    @relation("assignmentsAssignedBy")
  manifests     Manifest[]      @relation("manifestsCreatedBy")
  handovers     ManifestHandover[] @relation("handoverCompletedBy")
  customsDeclarations CustomsDeclaration[]
  blogPosts          BlogPost[]       @relation("blogPostsAuthor")
  claims             Claim[]          @relation("claimsCreatedBy")
  claimsAssigned     Claim[]          @relation("claimsAssignedTo")
  claimsResolved     Claim[]          @relation("claimsResolvedBy")
  tickets            SupportTicket[]  @relation("ticketsCreatedBy")
  ticketsAssigned    SupportTicket[]  @relation("ticketsAssignedTo")
  ticketReplies      TicketReply[]

  @@index([email])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  OPERATIONS_MANAGER
  SGR_STATION_OFFICER
  DISPATCHER
  FINANCE
  CUSTOMER_SUPPORT
  WAREHOUSE_MANAGER
  CUSTOMS_OFFICER
  PRICING_MANAGER
  REPORT_VIEWER
  CUSTOMER
  DRIVER
  // Attribution anchor for records created by an external partner via the integration API —
  // never a real login identity. See getOrCreateIntegrationSystemUser().
  PARTNER_API
}

// ============================================================
// ORGANIZATIONS (Corporate/Business customers)
// ============================================================

model Organization {
  id            String   @id @default(cuid())
  name          String
  legalName     String?
  taxId         String?
  email         String
  phone         String?
  address       String?
  city          String?
  country       String?
  website       String?
  logo          String?
  creditLimit   Decimal? @db.Decimal(12, 2)
  creditBalance Decimal? @db.Decimal(12, 2) @default(0)
  billingCycle  String?  @default("MONTHLY")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         OrganizationUser[]
  branches      Branch[]
  orders        Order[]
  shipments     Shipment[]
  customers     Customer[]

  @@map("organizations")
}

model OrganizationUser {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("STAFF")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_users")
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String
  city           String
  region         String?
  country        String   @default("Tanzania")
  phone          String?
  email          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  addresses      Address[]

  @@map("branches")
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id            String       @id @default(cuid())
  userId        String       @unique
  type          CustomerType @default(INDIVIDUAL)
  organizationId String?
  phone         String
  altPhone      String?
  address       String?
  city          String?
  region        String?
  country       String       @default("Tanzania")
  totalShipments Int         @default(0)
  totalSpent    Decimal      @default(0) @db.Decimal(12, 2)
  rating        Float?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization? @relation(fields: [organizationId], references: [id])
  orders        Order[]
  shipments     Shipment[]
  addresses     Address[]
  ratings       Rating[]

  @@map("customers")
}

enum CustomerType {
  GUEST
  INDIVIDUAL
  BUSINESS
  CORPORATE
}

// ============================================================
// ADDRESSES
// ============================================================

model Address {
  id          String   @id @default(cuid())
  customerId  String?
  branchId    String?
  label       String?
  fullName    String
  phone       String
  line1       String
  line2       String?
  city        String
  region      String?
  district    String?
  country     String   @default("Tanzania")
  postalCode  String?
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch      Branch?    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shipmentsFrom Shipment[] @relation("shipmentsFromAddress")
  shipmentsTo   Shipment[] @relation("shipmentsToAddress")

  @@map("addresses")
}

// ============================================================
// DRIVERS & CARRIERS & VEHICLES
// ============================================================

model Driver {
  id              String       @id @default(cuid())
  userId          String       @unique
  licenseNumber   String
  licenseClass    String?
  licenseIssueDate DateTime?
  licenseExpiry   DateTime?
  employmentType  String?      // e.g. EMPLOYEE, CONTRACTOR, PARTNER
  carrierId       String?
  status          DriverStatus @default(AVAILABLE)
  approvalStatus  DriverApprovalStatus @default(PENDING_VERIFICATION)
  emergencyContactName  String?
  emergencyContactPhone String?
  internalNotes   String?      // visible only to roles with drivers.manage
  rating          Float?
  totalDeliveries Int          @default(0)
  currentLatitude Float?
  currentLongitude Float?
  lastLocationAt  DateTime?
  isActive        Boolean      @default(true)
  isOnline        Boolean      @default(false)
  lastOnlineAt    DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  carrier         Carrier?     @relation(fields: [carrierId], references: [id])
  assignments     Assignment[]
  manifests       Manifest[]
  driverLocations DriverLocation[]
  shipments       Shipment[]
  ratings         Rating[]
  documents       DriverDocument[]
  orderOffers     OrderOffer[]
  rejections      DriverRejection[]
  matchedTransportRequest TransportRequest? @relation("transportMatchedDriver")
  trips           Trip[]
  sgrLegs         SGRLeg[]

  @@map("drivers")
}

model DriverDocument {
  id             String             @id @default(cuid())
  driverId       String
  type           DriverDocumentType
  documentNumber String?
  issueDate      DateTime?
  expiryDate     DateTime?
  fileUrl        String?
  status         DocumentStatus     @default(PENDING_VERIFICATION)
  verifiedById   String?
  verifiedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  driver         Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@map("driver_documents")
}

enum DriverStatus {
  AVAILABLE
  ASSIGNED
  ON_PICKUP
  ON_DELIVERY
  ON_TRIP
  ON_BREAK
  OFFLINE
  SUSPENDED
  INACTIVE
  MAINTENANCE
}

// Distinct from operational `status` above — this is the onboarding/HR lifecycle a driver
// moves through once, before they ever appear in dispatch at all.
enum DriverApprovalStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
  INACTIVE
}

enum DriverDocumentType {
  LICENSE
  IDENTIFICATION
  MEDICAL
  AUTHORIZATION
  OTHER
}

enum DocumentStatus {
  PENDING_VERIFICATION
  VALID
  EXPIRING_SOON
  EXPIRED
  REJECTED
}

model Carrier {
  id          String          @id @default(cuid())
  name        String
  type        CarrierType     @default(XERIN)
  email       String?
  phone       String?
  address     String?
  city        String?
  country     String          @default("Tanzania")
  licenseNo   String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  drivers     Driver[]
  vehicles    Vehicle[]
  shipments   Shipment[]
  transportCapacities TransportCapacity[]

  @@map("carriers")
}

enum CarrierType {
  XERIN
  PARTNER
  THIRD_PARTY
}

model Vehicle {
  id             String         @id @default(cuid())
  carrierId      String
  registrationNo String         @unique
  type           VehicleType
  capacityKg     Decimal        @db.Decimal(8, 2)
  capacityM3     Decimal?       @db.Decimal(8, 2)
  make           String?
  model          String?
  year           Int?
  fuelType       String?
  status         VehicleStatus  @default(AVAILABLE)
  insuranceExpiry     DateTime?
  roadLicenseExpiry   DateTime?
  inspectionExpiry    DateTime?
  fitnessExpiry       DateTime?
  currentLatitude Float?
  currentLongitude Float?
  lastLocationAt DateTime?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  carrier        Carrier        @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  manifests      Manifest[]
  shipments      Shipment[]
  assignments    Assignment[]
  maintenanceRecords VehicleMaintenanceRecord[]
  trips          Trip[]
  transportCapacities TransportCapacity[]
  matchedTransportRequest TransportRequest? @relation("transportMatchedVehicle")
  sgrLegs         SGRLeg[]

  @@map("vehicles")
}

model VehicleMaintenanceRecord {
  id              String    @id @default(cuid())
  vehicleId       String
  serviceDate     DateTime
  serviceType     String
  mileage         Int?
  cost            Decimal?  @db.Decimal(12, 2)
  description     String?
  nextServiceDate DateTime?
  status          String    @default("COMPLETED") // SCHEDULED | IN_PROGRESS | COMPLETED
  createdById     String?
  createdAt       DateTime  @default(now())

  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_maintenance_records")
}

enum VehicleType {
  MOTORCYCLE
  BICYCLE
  CAR
  VAN
  PICKUP
  TRUCK
  TRAILER
  CONTAINER
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
  INACTIVE
}

model DriverLocation {
  id          String   @id @default(cuid())
  driverId    String
  latitude    Float
  longitude   Float
  accuracy    Float?
  speed       Float?
  heading     Float?
  timestamp   DateTime @default(now())

  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, timestamp])
  @@map("driver_locations")
}

// ============================================================
// GEOGRAPHY: Countries, Regions, Cities, Zones
// ============================================================

model Country {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  currency  String   @default("TZS")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  cities     City[]
  zones      Zone[]
  regions    Region[]
  pricingRules PricingRule[]
  shipmentsFrom Shipment[] @relation("shipmentsFromCountry")
  shipmentsTo   Shipment[] @relation("shipmentsToCountry")

  @@map("countries")
}

model Region {
  id        String   @id @default(cuid())
  countryId String
  name      String
  code      String?
  isActive  Boolean  @default(true)

  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities    City[]
  zones     Zone[]

  @@map("regions")
}

model City {
  id        String   @id @default(cuid())
  countryId String
  regionId  String?
  name      String
  code      String?
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true)

  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  region    Region?  @relation(fields: [regionId], references: [id])
  zones     Zone[]
  routesFrom Route[] @relation("routesFromCity")
  routesTo   Route[] @relation("routesToCity")

  @@map("cities")
}

model Zone {
  id        String   @id @default(cuid())
  countryId String
  regionId  String?
  cityId    String?
  name      String
  code      String?
  isActive  Boolean  @default(true)

  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  region    Region?  @relation(fields: [regionId], references: [id])
  city      City?    @relation(fields: [cityId], references: [id])
  pricingRules PricingRule[]

  @@map("zones")
}

// ============================================================
// ROUTES
// ============================================================

model Route {
  id           String   @id @default(cuid())
  fromCityId   String
  toCityId     String
  distanceKm   Decimal  @db.Decimal(8, 2)
  estimatedHours Decimal? @db.Decimal(6, 1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fromCity     City     @relation("routesFromCity", fields: [fromCityId], references: [id])
  toCity       City     @relation("routesToCity", fields: [toCityId], references: [id])
  pricingRules PricingRule[]
  manifests    Manifest[]

  @@unique([fromCityId, toCityId])
  @@map("routes")
}

// ============================================================
// PRICING ENGINE
// ============================================================

model PricingRule {
  id              String           @id @default(cuid())
  name            String
  code            String           @unique
  type            PricingType
  category        ShipmentCategory?
  transportMode   TransportMode?
  serviceLevel    ServiceLevel?
  routeId         String?
  zoneId          String?
  countryId       String?
  baseFare        Decimal          @db.Decimal(12, 2) @default(0)
  perKg           Decimal?         @db.Decimal(12, 2)
  perKm           Decimal?         @db.Decimal(12, 2)
  perM3           Decimal?         @db.Decimal(12, 2)
  minCharge       Decimal?         @db.Decimal(12, 2)
  maxCharge       Decimal?         @db.Decimal(12, 2)
  weightTiers     Json?
  conditions      Json?
  priority        Int              @default(0)
  isActive        Boolean          @default(true)
  effectiveFrom   DateTime         @default(now())
  effectiveTo     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  route           Route?           @relation(fields: [routeId], references: [id])
  zone            Zone?            @relation(fields: [zoneId], references: [id])
  country         Country?         @relation(fields: [countryId], references: [id])
  surcharges      Surcharge[]

  @@map("pricing_rules")
}

enum PricingType {
  DISTANCE
  WEIGHT
  VOLUMETRIC
  ROUTE
  ZONE
  COUNTRY
  TRANSPORT
  SERVICE
  FLAT
  CUSTOM
}

model Surcharge {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  type          SurchargeType
  calculation   SurchargeCalc @default(FIXED)
  value         Decimal  @db.Decimal(12, 2)
  appliesTo     String?
  isActive      Boolean  @default(true)
  pricingRuleId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pricingRule   PricingRule? @relation(fields: [pricingRuleId], references: [id], onDelete: Cascade)

  @@map("surcharges")
}

enum SurchargeType {
  FUEL_SURCHARGE
  HANDLING_FEE
  LOADING_FEE
  UNLOADING_FEE
  WAREHOUSE_FEE
  INSURANCE
  CUSTOMS_HANDLING
  REMOTE_AREA_FEE
  FRAGILE_FEE
  OVERSIZE_FEE
  EXPRESS_FEE
  WEEKEND_FEE
  TAX
  OTHER
}

enum SurchargeCalc {
  FIXED
  PERCENTAGE
  PER_KG
  PER_KM
}

// ============================================================
// QUOTES
// ============================================================

model Quote {
  id              String   @id @default(cuid())
  quoteNumber     String   @unique
  createdById     String
  category        ShipmentCategory
  transportMode   TransportMode?
  serviceLevel    ServiceLevel @default(STANDARD)
  originCity      String
  destinationCity String
  originCountry   String   @default("Tanzania")
  destCountry     String   @default("Tanzania")
  distanceKm      Decimal? @db.Decimal(8, 2)
  actualWeightKg  Decimal  @db.Decimal(8, 2)
  volumetricWeightKg Decimal? @db.Decimal(8, 2)
  chargeableWeightKg Decimal @db.Decimal(8, 2)
  lengthCm        Decimal? @db.Decimal(8, 2)
  widthCm         Decimal? @db.Decimal(8, 2)
  heightCm        Decimal? @db.Decimal(8, 2)
  packageType     PackageType @default(PARCEL)
  currency        String   @default("TZS")
  subtotal        Decimal  @db.Decimal(12, 2)
  fees            Json?
  tax             Decimal  @db.Decimal(12, 2) @default(0)
  insurancePremium Decimal? @db.Decimal(12, 2)
  total           Decimal  @db.Decimal(12, 2)
  etaMin          Int?
  etaMax          Int?
  validUntil      DateTime
  status          QuoteStatus @default(VALID)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy       User     @relation("quotesCreatedBy", fields: [createdById], references: [id])
  order           Order?

  @@map("quotes")
}

enum QuoteStatus {
  VALID
  EXPIRED
  CONVERTED
  CANCELLED
}

model QuoteRequest {
  id              String   @id @default(cuid())
  requestNumber   String   @unique
  createdById     String
  category        ShipmentCategory
  transportMode   TransportMode?
  originCity      String
  destinationCity String
  originCountry   String   @default("Tanzania")
  destCountry     String   @default("Tanzania")
  weightKg        Decimal  @db.Decimal(8, 2)
  lengthCm        Decimal? @db.Decimal(8, 2)
  widthCm         Decimal? @db.Decimal(8, 2)
  heightCm        Decimal? @db.Decimal(8, 2)
  description     String?
  specialHandling String?
  status          QuoteRequestStatus @default(PENDING)
  quotedPrice     Decimal? @db.Decimal(12, 2)
  quotedCurrency  String?  @default("TZS")
  validityDays    Int?     @default(7)
  adminNotes      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy       User     @relation(fields: [createdById], references: [id])

  @@map("quote_requests")
}

enum QuoteRequestStatus {
  PENDING
  QUOTED
  ACCEPTED
  REJECTED
  REVISION_REQUESTED
  EXPIRED
}

// ============================================================
// ORDERS & SHIPMENTS
// ============================================================

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique
  createdById     String
  customerId      String?
  organizationId  String?
  quoteId         String?  @unique
  totalAmount     Decimal      @db.Decimal(12, 2)
  currency        String       @default("TZS")
  paymentStatus   PaymentStatus @default(PENDING)
  status          OrderStatus  @default(CREATED)
  notes           String?
  // External partner order import (Part G) — never rely on XERIN's internal id alone for
  // a partner-originated order; this is how a duplicate import attempt gets detected too.
  partnerId       String?
  externalOrderId String?
  externalReference String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  createdBy       User         @relation("ordersCreatedBy", fields: [createdById], references: [id])
  customer        Customer?    @relation(fields: [customerId], references: [id])
  organization    Organization? @relation(fields: [organizationId], references: [id])
  quote           Quote?       @relation(fields: [quoteId], references: [id])
  partner         Partner?     @relation("partnerOrders", fields: [partnerId], references: [id])
  shipments       Shipment[]
  payments        Payment[]
  invoices        Invoice[]
  paymentRequests PaymentRequest[]

  @@unique([partnerId, externalOrderId])
  @@map("orders")
}

enum OrderStatus {
  CREATED
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
  FAILED
}

model Shipment {
  id               String           @id @default(cuid())
  trackingNumber   String           @unique
  orderId          String
  createdById      String
  customerId       String?
  organizationId   String?
  carrierId        String?
  driverId         String?
  vehicleId        String?
  fromAddressId    String
  toAddressId      String
  fromCountryId    String?
  toCountryId      String?

  category         ShipmentCategory
  shipmentType     String?
  transportMode    TransportMode    @default(ROAD)
  serviceLevel     ServiceLevel     @default(STANDARD)
  fulfillmentType  FulfillmentType  @default(DOOR_TO_DOOR)

  status           ShipmentStatus   @default(BOOKED)
  paymentStatus    PaymentStatus    @default(PENDING)

  actualWeightKg   Decimal          @db.Decimal(8, 2)
  volumetricWeightKg Decimal?       @db.Decimal(8, 2)
  chargeableWeightKg Decimal        @db.Decimal(8, 2)
  declaredValue    Decimal?         @db.Decimal(12, 2)
  insuranceEnabled Boolean          @default(false)
  insurancePremium Decimal?         @db.Decimal(12, 2)

  totalAmount      Decimal          @db.Decimal(12, 2)
  currency         String           @default("TZS")
  baseCurrencyAmount Decimal?       @db.Decimal(12, 2)
  exchangeRate     Decimal?         @db.Decimal(10, 4)

  specialHandling  String[]
  description      String?
  estimatedPickup  DateTime?
  estimatedDelivery DateTime?
  actualPickup     DateTime?
  actualDelivery   DateTime?

  // Parcel flow fields (from drivemond)
  parcelCategoryId String?
  otp              String?
  proofImageUrl    String?
  scheduledAt      DateTime?
  payer            String         @default("SENDER")
  tips             Decimal?       @db.Decimal(12, 2) @default(0)
  cancellationReason String?
  isParcelDeliveryProofEnabled Boolean @default(false)
  isScheduled      Boolean        @default(false)
  isPaused         Boolean        @default(false)
  note             String?
  pickupNote       String?

  // SGR Parcel Service fields
  originStationId       String?
  destinationStationId  String?
  sgrServiceType        String?   // STATION_TO_STATION | DOOR_TO_STATION | STATION_TO_DOOR | DOOR_TO_DOOR
  trainNumber           String?
  trainDepartureAt      DateTime?
  trainArrivalAt        DateTime?

  // Air Cargo fields
  awbNumber             String?   // Air Waybill number
  flightNumber          String?
  flightDepartureAt     DateTime?
  flightArrivalAt       DateTime?
  airportOrigin         String?   // Origin airport/city code
  airportDestination    String?   // Destination airport/city code
  airCargoServiceType   String?   // AIRPORT_TO_AIRPORT | DOOR_TO_AIRPORT | AIRPORT_TO_DOOR | DOOR_TO_DOOR
  cargoType             String?   // GENERAL | PERISHABLE | DANGEROUS | FRAGILE | VALUABLE
  airCargoSpecialHandling String? // Special handling instructions for air cargo

  // Vehicle category for road transport (BODA_BODA | VAN | TRUCK)
  vehicleCategory       String?

  // Smart dispatch fields
  dispatchMode          DispatchMode @default(DIRECT_ASSIGNMENT)
  dispatchOfferRadius   Int?    // km radius for open order offers
  dispatchAssignedAt    DateTime?
  dispatchAcceptedAt    DateTime?

  // Warehouse / Fulfillment Center fields
  shelfBinLocation      String?
  consolidationBatchId  String?
  weighedAt             DateTime?
  labeledAt             DateTime?

  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // External partner shipment import (Part G/H) — a partner-originated shipment always
  // carries the id it knows the transaction by, independent of our own tracking number.
  partnerId        String?
  externalShipmentId String?
  externalReference String?

  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partner          Partner?         @relation("partnerShipments", fields: [partnerId], references: [id])
  createdBy        User             @relation("shipmentsCreatedBy", fields: [createdById], references: [id])
  customer         Customer?        @relation(fields: [customerId], references: [id])
  organization     Organization?    @relation(fields: [organizationId], references: [id])
  carrier          Carrier?         @relation(fields: [carrierId], references: [id])
  driver           Driver?          @relation(fields: [driverId], references: [id])
  vehicle          Vehicle?         @relation(fields: [vehicleId], references: [id])
  fromAddress      Address          @relation("shipmentsFromAddress", fields: [fromAddressId], references: [id])
  toAddress        Address          @relation("shipmentsToAddress", fields: [toAddressId], references: [id])
  fromCountry      Country?         @relation("shipmentsFromCountry", fields: [fromCountryId], references: [id])
  toCountry        Country?         @relation("shipmentsToCountry", fields: [toCountryId], references: [id])

  packages         Package[]
  trackingEvents   TrackingEvent[]
  statusHistory    ShipmentStatusHistory[]
  assignments      Assignment[]
  manifests        Manifest[]
  waybills         Waybill[]
  documents        ShipmentDocument[]
  customsDeclaration CustomsDeclaration?
  ratings          Rating[]
  parcelCategory   ParcelCategory?  @relation(fields: [parcelCategoryId], references: [id])
  proofImages      ShipmentProofImage[]
  station          Station?        @relation("stationShipments", fields: [stationId], references: [id])
  receivedAtStation Station?       @relation("stationReceivedShipments", fields: [receivedAtStationId], references: [id])
  originStation    Station?        @relation("originStationShipments", fields: [originStationId], references: [id])
  destinationStation Station?      @relation("destStationShipments", fields: [destinationStationId], references: [id])
  stationInventory StationInventory[]
  exceptions       ShipmentException[]
  claims           Claim[]
  tickets          SupportTicket[]
  orderOffers      OrderOffer[]
  rejections       DriverRejection[]
  transportRequest TransportRequest?
  trips            Trip[]
  settlements      Settlement[]
  matchedCapacity  TransportCapacity? @relation("capacityMatchedShipment")
  sgrLegs          SGRLeg[]
  trainAllocations TrainAllocation[]
  whatsappMessages WhatsAppMessage[]

  // Station fields
  stationId        String?
  receivedAtStationId String?

  @@unique([partnerId, externalShipmentId])
  @@index([trackingNumber])
  @@index([status])
  @@map("shipments")
}

enum ShipmentCategory {
  DOMESTIC
  INTERNATIONAL
  SPECIAL_TRANSPORT
}

enum TransportMode {
  ROAD
  AIR
  SEA
  COURIER
  RAIL
}

enum ServiceLevel {
  STANDARD
  EXPRESS
  SAME_DAY
  NEXT_DAY
  ECONOMY
  PRIORITY
}

enum FulfillmentType {
  DOOR_TO_DOOR
  DOOR_TO_PICKUP
  PICKUP_TO_DOOR
  PICKUP_TO_PICKUP
  WAREHOUSE_TO_DOOR
  WAREHOUSE_TO_PICKUP
}

enum ShipmentStatus {
  PENDING
  QUOTE_CREATED
  BOOKED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  AWAITING_PICKUP
  AWAITING_CARGO
  DRIVER_ASSIGNED
  ACCEPTED
  OUT_FOR_PICKUP
  PICKED_UP
  RECEIVED_AT_STATION
  CARGO_RECEIVED
  SCREENING
  VERIFIED_WEIGHED
  READY_FOR_RAIL
  TRAIN_ASSIGNED
  MANIFESTED
  CONSOLIDATED
  READY_FOR_DISPATCH
  LOADED
  LOADED_FOR_DISPATCH
  TRAIN_DEPARTED
  IN_TRANSIT
  ONGOING
  TRAIN_ARRIVED
  ARRIVED_DESTINATION
  DESTINATION_STATION
  ARRIVED_COUNTRY
  CUSTOMS_REVIEW
  CUSTOMS_CLEARED
  READY_FOR_COLLECTION
  LAST_MILE_ASSIGNED
  WAREHOUSE
  OUT_FOR_DELIVERY
  DELIVERED
  COLLECTED
  DELIVERY_FAILED
  RETURNING
  RETURNED
  FAILED
  CANCELLED
  ON_HOLD
  EXCEPTION
}

model ShipmentStatusHistory {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
